# User/Group IDs the syncthing process runs as. 568/568 match the previous
# TrueNAS catalog app defaults, so a migrated config directory keeps working
# without chowning. The image entrypoint starts as root, chowns
# /var/syncthing, then drops to these IDs via su-exec.
PUID=568
PGID=568

# Timezone (IANA name).
TZ=Etc/UTC

# Existing host path (usually a /mnt/<pool>/... dataset mount) containing the
# folders syncthing should sync, mounted read-write at /data in the
# container. Point it at a parent directory of several folders, or add more
# volume mounts in compose.yaml for paths on other datasets.
SYNCTHING_DATA_PATH=/mnt/tank/path-to-sync
