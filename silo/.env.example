# Root account for the S3 API (port 9000) and the web console (port 9002).
# Silo keeps MinIO's MINIO_* variable names. Set the real values in
# silo/.env on the TrueNAS repo clone; never commit them. Reuse the MinIO
# values so existing clients and mc aliases keep working.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too
