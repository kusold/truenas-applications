# Existing host path (usually a /mnt/<pool>/... dataset mount) to serve over
# WebDAV. Mounted at /srv/share1 in the container and served at
# http://<host>:30035/. Must be readable (and writable, unless the share is
# made read-only in the Caddyfile) by uid/gid 568.
WEBDAV_SHARE_PATH=/mnt/tank/path-to-serve

# WEBDAV_CONFIG_DATASET (the tank/red/Applications/webdav dataset holding the
# Caddyfile) is generated by the deployer into .truenas-generated.env; it is
# not set in this file.
