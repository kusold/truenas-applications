# Existing host path (usually a /mnt/<pool>/... dataset mount) to serve over
# the S3 API. The gateway is stateless; objects are stored directly in this
# path and remain accessible via POSIX.
VGW_DATA_PATH=/mnt/tank/path-to-serve

# Previous object versions for buckets with versioning enabled. Must be
# OUTSIDE VGW_DATA_PATH (the gateway refuses to start otherwise); a sibling
# directory on the same ZFS dataset is recommended, e.g.
# /mnt/tank/path-to-serve-versions.
VGW_VERSIONING_PATH=/mnt/tank/path-to-serve-versions

# Root account credentials. Used for both S3 requests and Web UI login.
ROOT_ACCESS_KEY=change-me
ROOT_SECRET_KEY=change-me-too
