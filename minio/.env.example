# MinIO root account, used for the S3 API (port 9000) and the web console
# (port 9002). Set the real values in minio/.env on the TrueNAS repo clone;
# never commit them. Reuse the values from the converted app so existing
# clients and mc aliases keep working.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too
